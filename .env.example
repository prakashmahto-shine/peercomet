# ==============================================================================
# PeerPath backend configuration (copy to .env)
# ==============================================================================

# development | production
APP_ENV=development
PORT=5001

# --- Database -----------------------------------------------------------------
# Local default (if unset): SQLite file at backend/data/peerpath.sqlite3
# Production: the company Postgres (Shine infra / self-hosted), e.g.:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Load the demo creators/candidates into an empty DB (ignored in production)
SEED_DEMO_DATA=true
# Enables POST /api/demo/reset (ignored in production)
DEMO_MODE=false

# --- Login (Shine) --------------------------------------------------------------
# mock = local/staging: no SMS, OTP is MOCK_OTP_CODE. Not allowed in production.
# live = Shine auth APIs (needs SHINE_API_KEY issued for the PeerPath backend)
SHINE_AUTH_MODE=mock
MOCK_OTP_CODE=123456
# SHINE_BFF_URL=https://www.shine.com/pages/bff/api/v1
# SHINE_API_KEY=

# --- Sessions -------------------------------------------------------------------
SESSION_TTL_DAYS=30
# Defaults to true in production (cookie only over HTTPS)
# SESSION_COOKIE_SECURE=true

# --- Access -----------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:4242,http://127.0.0.1:4242
# PeerPath user ids with admin / recruiter access (comma-separated)
ADMIN_USER_IDS=
RECRUITER_USER_IDS=

# --- Frontend (Vite) ------------------------------------------------------------
# Leave empty when the frontend and API are served from the same host
# VITE_API_URL=https://api.peerpath.in
