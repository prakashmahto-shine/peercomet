# ==============================================================================
# PeerPath configuration. Copy to .env and fill in.
# On servers (staging/production) every value comes from real infrastructure:
# no mock login, no demo data. See docs/DEPLOYMENT.md.
# ==============================================================================

# development (your laptop) | staging | production
APP_ENV=production
PORT=5001

# --- Database (PostgreSQL 14+) --------------------------------------------------
# Required on servers. Locally, leave unset to use a SQLite file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Login & registration via Shine ---------------------------------------------
# Servers always use 'live'. Until PEERPATH_AUTH_API_KEY is set, the app runs but login returns 503.
PEERPATH_AUTH_MODE=live
PEERPATH_AUTH_API_URL=https://www.shine.com/pages/bff/api/v1
PEERPATH_AUTH_API_KEY=

# --- Sessions -----------------------------------------------------------------------
SESSION_TTL_DAYS=30

# --- Access -------------------------------------------------------------------------
# Public site origin(s), comma-separated
CORS_ORIGINS=https://peerpath.in
# PeerPath user ids with admin / recruiter access (comma-separated)
ADMIN_USER_IDS=
RECRUITER_USER_IDS=

# --- Session recordings ---------------------------------------------------------------
# s3 (recommended) or local (needs a persistent disk/volume at RECORDINGS_DIR)
RECORDINGS_STORAGE=s3
S3_BUCKET=
S3_PREFIX=recordings
S3_REGION=ap-south-1
# S3_ENDPOINT_URL=          # only for non-AWS S3-compatible storage
# AWS_ACCESS_KEY_ID=        # omit when the machine/pod has an IAM role
# AWS_SECRET_ACCESS_KEY=
# RECORDINGS_DIR=/app/backend/data/recordings
MAX_RECORDING_MB=500

# --- Video calls (WebRTC) ---------------------------------------------------------------
# TURN is required in production for users behind strict NATs/firewalls
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# STUN_URLS=stun:stun.l.google.com:19302

# ==============================================================================
# Local development only (APP_ENV=development). Refused on servers.
# ==============================================================================
# APP_ENV=development
# PEERPATH_AUTH_MODE=mock      # fixed OTP, no SMS, demo users (e.g. 'akash')
# MOCK_OTP_CODE=123456
# SEED_DEMO_DATA=true       # load backend/data/db.json into an empty database
# DEMO_MODE=false           # enables POST /api/demo/reset
# SESSION_COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:4242,http://127.0.0.1:4242
# RECORDINGS_STORAGE=local
#
# Frontend (Vite), only when the API is on a different host than the site:
# VITE_API_URL=https://api.peerpath.in
