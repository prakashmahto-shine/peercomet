# ==============================================================================
# PeerComet server configuration. Copy to .env next to docker-compose.yml and fill in.
# Keep .env out of git. No mock login or demo data runs on servers.
# See docs/DEPLOYMENT.md ("Single-server setup").
# ==============================================================================

APP_ENV=production
PORT=5001

# --- Server / domain ------------------------------------------------------------------
# Public domain pointing at this server (used for HTTPS, CORS and TURN)
SITE_DOMAIN=peercomet.com
# The server's public IP (needed by the TURN server)
SERVER_PUBLIC_IP=
# Optional services: 'caddy' (HTTPS on 80/443; omit if the server already runs nginx), 'turn',
# 'mailpit' (staging only, see the sign-in section)
COMPOSE_PROFILES=caddy,turn

# --- Database (PostgreSQL in docker compose) -------------------------------------------
# docker compose builds DATABASE_URL from this. Use a long random value.
POSTGRES_PASSWORD=
BACKUP_KEEP_DAYS=14
# Only for a database outside docker compose:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/peercomet

# --- Sign-in / sign-up: 6-digit code by email (SMTP) -------------------------------------
# Any SMTP service works (company mail server, Gmail app password, Amazon SES, Brevo, Zoho, ...).
# Servers always send a random code; there is no fixed code. Until SMTP_HOST and EMAIL_FROM
# are set, the app runs but sign-in returns 503.
#
# Staging without real email: add 'mailpit' to COMPOSE_PROFILES and use
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_SECURITY=none  (no username/password)
# Codes then appear in the Mailpit inbox at http://<server>:8025.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=PeerComet <no-reply@peercomet.com>
OTP_TTL_MINUTES=10
# Mailpit inbox login as user:password (set it; the inbox shows everyone's codes)
# MAILPIT_UI_AUTH=team:change-me
# Where the inbox listens: 127.0.0.1 (SSH tunnel) or 0.0.0.0 (office network / VPN only)
# MAILPIT_UI_BIND=127.0.0.1

# --- Sessions & access -----------------------------------------------------------------
SESSION_TTL_DAYS=30
# Admin access (comma-separated). Admins sign in with the normal email code at /admin.
ADMIN_EMAILS=
ADMIN_USER_IDS=
# Recruiter access: PeerComet user ids (comma-separated)
RECRUITER_USER_IDS=

# --- Session recordings ------------------------------------------------------------------
# local = Docker volume on this server; s3 = S3-compatible bucket
RECORDINGS_STORAGE=local
MAX_RECORDING_MB=500
# S3_BUCKET=
# S3_PREFIX=recordings
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Video calls (TURN, served by the 'turn' profile) ------------------------------------
# Choose a username and a long random password
TURN_USERNAME=peercomet
TURN_CREDENTIAL=
# Defaults to turn:<SITE_DOMAIN>:3478
# TURN_URLS=

# --- Branding ------------------------------------------------------------------------------
# Name used in backend messages (the website's name is in src/config/brand.ts)
BRAND_NAME=PeerComet

# ==============================================================================
# Local development only (APP_ENV=development). Refused on servers.
# Locally you don't need a .env at all.
# ==============================================================================
# APP_ENV=development
# EMAIL_BACKEND=console       # default locally: no email, the code is DEV_OTP_CODE and is
# DEV_OTP_CODE=123456         # printed in the backend terminal. Ignored on servers.
# SESSION_COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:4242,http://127.0.0.1:4242
