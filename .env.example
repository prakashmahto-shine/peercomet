# ==============================================================================
# PeerPath server configuration. Copy to .env next to docker-compose.yml and fill in.
# Keep .env out of git. No mock login or demo data runs on servers.
# See docs/DEPLOYMENT.md ("Single-server setup").
# ==============================================================================

APP_ENV=production
PORT=5001

# --- Server / domain ------------------------------------------------------------------
# Public domain pointing at this server (used for HTTPS, CORS and TURN)
SITE_DOMAIN=peerpath.in
# The server's public IP (needed by the TURN server)
SERVER_PUBLIC_IP=
# Optional services: 'caddy' (HTTPS on 80/443; omit if the server already runs nginx), 'turn'
COMPOSE_PROFILES=caddy,turn

# --- Database (PostgreSQL in docker compose) -------------------------------------------
# docker compose builds DATABASE_URL from this. Use a long random value.
POSTGRES_PASSWORD=
BACKUP_KEEP_DAYS=14
# Only for a database outside docker compose:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/peerpath

# --- Sign-in / sign-up: 6-digit code by email (SMTP) -------------------------------------
# Any SMTP service works (company mail server, Amazon SES, SendGrid, Brevo, Zoho, ...).
# Until SMTP_HOST and EMAIL_FROM are set, the app runs but sign-in returns 503.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=PeerPath <no-reply@peerpath.in>
OTP_TTL_MINUTES=10

# --- Sessions & access -----------------------------------------------------------------
SESSION_TTL_DAYS=30
# PeerPath user ids with admin / recruiter access (comma-separated)
ADMIN_USER_IDS=
RECRUITER_USER_IDS=

# --- Session recordings ------------------------------------------------------------------
# local = Docker volume on this server; s3 = S3-compatible bucket
RECORDINGS_STORAGE=local
MAX_RECORDING_MB=500
# S3_BUCKET=
# S3_PREFIX=recordings
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Video calls (TURN, served by the 'turn' profile) ------------------------------------
# Choose a username and a long random password
TURN_USERNAME=peerpath
TURN_CREDENTIAL=
# Defaults to turn:<SITE_DOMAIN>:3478
# TURN_URLS=

# --- Branding ------------------------------------------------------------------------------
# Name used in backend messages (the website's name is in src/config/brand.ts)
BRAND_NAME=PeerPath

# ==============================================================================
# Local development only (APP_ENV=development). Refused on servers.
# Locally you don't need a .env at all.
# ==============================================================================
# APP_ENV=development
# EMAIL_BACKEND=console       # no email: the code is DEV_OTP_CODE, printed in the log;
# DEV_OTP_CODE=123456         # demo user ids (e.g. 'akash') also work instead of an email
# SEED_DEMO_DATA=true      # load sample mentors/candidates (off by default)
# DEMO_MODE=false
# SESSION_COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:4242,http://127.0.0.1:4242
